<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase 3 Task 3.2 unblock: the androidTest APK inherits
  .notifications.ExecutionAlarmRescheduleReceiver from the production
  manifest via the manifest merger. That receiver is annotated with
  @AndroidEntryPoint and crashes on MY_PACKAGE_REPLACED because Hilt is
  not yet initialized when the broadcast fires immediately after
  adb install. The crash kills the test process before instrumentation
  can hand off, so `am instrument` reports "Process crashed before
  executing the test(s)" regardless of which single class is targeted.

  Removing the receiver ONLY from the androidTest merged manifest lets
  the production app keep its existing behaviour while unblocking the
  instrumented QuickCreateSmokeTest added for M3 Phase 3.

  This file touches production source only at the test-source-set
  scope; no production Kotlin / Java / manifest changes ship.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <receiver
            android:name=".notifications.ExecutionAlarmRescheduleReceiver"
            tools:node="remove" />
    </application>
</manifest>
