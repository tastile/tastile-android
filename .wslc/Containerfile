# tastile-android development container
# ────────────────────────────────────────────────────────────────────
# Versions are auto-extracted by wslc-build.ps1 from app/build.gradle.kts.
# Do NOT hardcode versions here — always use --build-arg from the script.
#
# Build: .wslc/wslc-build.ps1
# Dev:   .wslc/wslc-dev.ps1
# ────────────────────────────────────────────────────────────────────

FROM ubuntu:24.04

ARG ANDROID_COMMAND_LINE_TOOLS_VERSION=13114758
ARG ANDROID_COMPILE_SDK
ARG ANDROID_BUILD_TOOLS=36.0.0
ARG ANDROID_NDK_VERSION
ARG JAVA_VERSION=17

ENV DEBIAN_FRONTEND=noninteractive
ENV JAVA_HOME=/usr/lib/jvm/java-${JAVA_VERSION}-openjdk-amd64
ENV ANDROID_HOME=/opt/android-sdk
ENV ANDROID_SDK_ROOT=/opt/android-sdk
ENV PATH="${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/platform-tools:${JAVA_HOME}/bin:${PATH}"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        openjdk-${JAVA_VERSION}-jdk-headless \
        unzip \
        zip \
        adb \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p "${ANDROID_HOME}/cmdline-tools" \
    && curl -fsSL \
        "https://dl.google.com/android/repository/commandlinetools-linux-${ANDROID_COMMAND_LINE_TOOLS_VERSION}_latest.zip" \
        -o /tmp/android-tools.zip \
    && unzip -q \
        /tmp/android-tools.zip \
        -d /tmp/android-tools \
    && mkdir -p \
        "${ANDROID_HOME}/cmdline-tools/latest" \
    && mv \
        /tmp/android-tools/cmdline-tools/* \
        "${ANDROID_HOME}/cmdline-tools/latest/" \
    && rm -rf \
        /tmp/android-tools \
        /tmp/android-tools.zip

RUN yes | sdkmanager \
        --sdk_root="${ANDROID_HOME}" \
        --licenses \
        >/dev/null

RUN sdkmanager \
        --sdk_root="${ANDROID_HOME}" \
        "platform-tools" \
        "platforms;android-${ANDROID_COMPILE_SDK}" \
        "build-tools;${ANDROID_BUILD_TOOLS}" \
        "ndk;${ANDROID_NDK_VERSION}"

# ── Install adb wrapper that routes through the docker-desktop WSL2 adb proxy ──
# wslc containers cannot see USB devices directly — the kernel module matching
# the WSL2 kernel (6.18.35.2-microsoft) is not shipped, and wslc has no
# `--device` / `--privileged` flags. Instead we run the canonical adb server on
# the docker-desktop WSL2 distro (which sees /dev/bus/usb after
# `usbipd attach --wsl`), then point every adb client in this container at it
# via ADB_SERVER_SOCKET. The real adb binary is renamed to adb.real so the
# wrapper takes its place on PATH (platform-tools precedes /usr/local/bin).
#
# Default ADB_PROXY_HOST is empty; set it at `wslc run` time via -e, or write
# /etc/adb-proxy-host from .wslc/wslc-adb-proxy.ps1 after discovery. The
# wrapper falls back to probing the Windows-side nameserver (192.168.x.1) and
# the wslc bridge gateway (172.17.0.1) before giving up.
COPY .wslc/adb-wrapper.sh /usr/local/lib/adb-wrapper.sh
RUN chmod +x /usr/local/lib/adb-wrapper.sh \
    && mv "${ANDROID_HOME}/platform-tools/adb" "${ANDROID_HOME}/platform-tools/adb.real" \
    && ln -s /usr/local/lib/adb-wrapper.sh "${ANDROID_HOME}/platform-tools/adb"

# Entrypoint for development mode
COPY .wslc/entrypoint-dev.sh /entrypoint-dev.sh
RUN chmod +x /entrypoint-dev.sh

WORKDIR /workspace

ENTRYPOINT ["/entrypoint-dev.sh"]
